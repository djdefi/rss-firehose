<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#efefef">
  <link rel="icon" sizes="192x192" href="img/icon.png">
  <link rel="apple-touch-icon" href="img/icon.png">
  <link type="text/css" rel="stylesheet" href="main.css"/>
  <link rel="manifest" href="./manifest.json">
  <title><%= title %></title>
  <meta name="description" content="<%= description %>"/>
</head>
<body>
<div>
	<div style="padding:10px;">
		<strong style="color:#c00;"><%= title %></strong>
		|
		<span><%= Time.now.strftime('%F %R %Z') -%></span>
	</div><hr/>
	<div class="firehose">
		<strong>Stories</strong>
<p>
<% feeds.each do |feed| -%>

  <h3>
    <a href='<%= h feed[:site] %>'><%= h feed[:site] %> - <%= feed[:items].count %> items<%= feed[:error] ? ' (unavailable)' : '' %>:</a>
  </h3>
      <ul>
        <% feed[:items].each do |item| -%>
      <li>
          <a href='<%= h item[:link] %>'><%= h item[:title] %></a>
        </li>
    <% end -%>
      </ul>

<% end -%>
</p>
</div>
</div>

<% if analytics_ua %>
<script>
  window.ga=window.ga||function(){(ga.q=ga.q||[]).push(arguments)};ga.l=+new Date;
  ga('create', '<%= analytics_ua %>', 'auto');
  ga('send', 'pageview');
</script>
<script async src='https://www.google-analytics.com/analytics.js'></script>
<% end %>

</body>
</html>
